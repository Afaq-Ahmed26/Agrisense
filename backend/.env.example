# Firebase Configuration
FIREBASE_API_KEY="your-firebase-web-api-key"
FIREBASE_CONFIG_PATH="your-path-to-firebase-credentials.json"
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Admin credentials for the sensor data generator script
# IMPORTANT: This user must exist in your Firebase Authentication users
ADMIN_EMAIL="your-admin-user@example.com"
ADMIN_PASSWORD="your-admin-user-password"

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-and-long-random-string-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrisense

# ML Model
ML_MODEL_PATH=model/irrigation_model.pkl
